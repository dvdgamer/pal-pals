{
  "expo": {
    "experiments": {
      "typedRoutes": true
    },
    "name": "pal-pals",
    "slug": "pal-pals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.palpals"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "description": "An app to help you find your next best friend",
    "jsEngine": "jsc",
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
